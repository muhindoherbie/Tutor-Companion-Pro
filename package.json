{
  "name": "tutor-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.js",
    "build": "tsc && vite build",
    "build:exe": "tsc && vite build && npx electron-builder --win",
    "build:apk": "tsc && vite build && npx cap sync android",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "build": {
    "appId": "com.tutorcompanion.app",
    "productName": "Tutor Companion",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/icon-512.svg"
    }
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "clsx": "^2.1.1",
    "docx": "^9.12.0",
    "express": "^5.3.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
